{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "tray-popup"],
  "permissions": [
    "core:default",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister-all",
    "notification:default",
    "opener:default"
  ]
}
